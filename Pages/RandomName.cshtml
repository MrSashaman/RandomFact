@page
@model RandomName
@{
    ViewData["Title"] = "Основная страница";
}


<div class="text-center">
    <h1 class="display-4">Добро пожаловать!</h1>
    <p>Рандомные имена на ваш вкус и цвет :D</p>
    <h2>@Model.CurrentName</h2>
    <div class="buttons-container">

    <form method="post">

    <button type="RndF">Рандомное имя</button>
    <button id="toggle-btn" type="button">Сменить тему</button>

    </form>
    </div>
    <hr>
    <img src="/css/img/hamster.jpg" alt="A cute hamster">

<script src="/ChangeTheme.js"></script>
</div>
